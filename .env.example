# Docker Compose ve Spring Boot ortak degisken sablonu.
# Kopyalayip ".env" olarak kaydet, degerleri kendi ortamina gore doldur.
# ".env" dosyasi git'e eklenmemelidir (.gitignore icinde).

# --- MSSQL Server ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=capacity_planner
DB_USERNAME=sa
DB_PASSWORD=CapacityPlanner!2024
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# --- Redis (L2 cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=capacity_planner
RABBITMQ_PASSWORD=capacity_planner

# --- Jira entegrasyonu (bos birakilirsa NoOp adaptor calisir) ---
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_ACCOUNT_EMAIL=
JIRA_API_KEY=

# --- MinIO (S3 uyumlu object storage - kapak gorseli yukleme vb.) ---
MINIO_ROOT_USER=capacity_planner
MINIO_ROOT_PASSWORD=capacity_planner
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
